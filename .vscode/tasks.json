{
    "version": "2.0.0",
    "tasks": [
        {
            // Ctrl+Shift+B builds the project.
            "label": "build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/Pong/Pong.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "clean",
            "type": "process",
            "command": "dotnet",
            "args": [
                "clean",
                "${workspaceFolder}/Pong/Pong.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
